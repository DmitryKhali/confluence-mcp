CONFLUENCE_BASE_URL=https://your-confluence.example.com
# Optional: max chars before truncation (default 50000)
# CONFLUENCE_MAX_CHARS=50000
# Optional: override Keychain service name (default "confluence_pat")
# CONFLUENCE_KEYCHAIN_SERVICE=confluence_pat
# Optional: set token directly via env var instead of Keychain
# CONFLUENCE_TOKEN=your-token
# Optional: Jira issue URL prefix, required only for linkify_jira_keys
# JIRA_BROWSE_URL=https://jira.example.com/browse/
